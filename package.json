{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "JARVIS \u2014 a local desktop workspace for Codex",
  "license": "MIT",
  "main": "dist/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "build": "vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "test:install": "python3 tests/install-fixture.py",
    "format": "prettier --write src tests scripts package.json tsconfig.json vite.config.ts vitest.config.ts",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json vite.config.ts vitest.config.ts",
    "package": "npm run build && node scripts/package.mjs",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "test:live": "node tests/live-e2e.mjs",
    "test:launcher": "node tests/installed-launch.mjs",
    "test:cold-launch": "node tests/cold-launch.mjs"
  },
  "dependencies": {
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.187.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "electron": "45.3.2",
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
